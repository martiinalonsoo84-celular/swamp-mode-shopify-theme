[
  {
    "name": "theme_info",
    "theme_name": "Swamp Mode",
    "theme_version": "1.0.0",
    "theme_author": "Swamp Mode",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "bebas_neue_n4",
        "label": "Heading font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#0A0A0A",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#151515",
        "label": "Surface (cards, panels)"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#F5F5F5",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#A1A1A1",
        "label": "Muted text"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#BFFF00",
        "label": "Accent (CTAs, highlights)"
      },
      {
        "type": "color",
        "id": "accent_secondary_color",
        "default": "#8DAA17",
        "label": "Accent secondary"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  }
]
