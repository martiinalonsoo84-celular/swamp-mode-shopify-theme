{% comment %}
  Swamp Mode — Featured Products Section
  Grid de productos destacados usando el snippet reutilizable 'product-card'.
  2 columnas mobile / 4 columnas desktop.

  PLACEHOLDER MODE: Datos hardcodeados hasta que la tienda esté activa.
  Cuando conectes Shopify:
    - Reemplazar cada `render 'product-card'` con un loop sobre una colección:
      {% for product in collections['featured'].products limit: 4 %}
        {% render 'product-card',
          card_url:        product.url,
          card_image_src:  product.featured_image | image_url: width: 400,
          card_image_alt:  product.featured_image.alt,
          card_image_id:   forloop.index | prepend: 'product-card-',
          card_title:      product.title,
          card_price:      product.price | money,
          card_badge:      product.tags contains 'new' | ternary: 'Nuevo', '',
          card_badge_type: 'accent'
        %}
      {% endfor %}
{% endcomment %}

<section class="featured-products section-padding" id="featured-products">
  <div class="section-header">
    <h2>Lo Más <span class="accent-text">Vendido</span></h2>
    <p>Los favoritos de la comunidad Swamp Mode</p>
  </div>

  <div class="featured-products__grid">
    {% comment %} PLACEHOLDER: Replace with collection product loop {% endcomment %}

    {% render 'product-card',
      card_url:        '#',
      card_image_src:  'placeholder-hoodie.png' | asset_url,
      card_image_alt:  'Hoodie Swamp Oversize',
      card_image_id:   'product-card-1',
      card_title:      'Hoodie Swamp Oversize',
      card_price:      '$34.990 CLP',
      card_badge:      'Nuevo',
      card_badge_type: 'accent'
    %}

    {% render 'product-card',
      card_url:        '#',
      card_image_src:  'placeholder-tee.png' | asset_url,
      card_image_alt:  'Tee Graphic Swamp',
      card_image_id:   'product-card-2',
      card_title:      'Tee Graphic Swamp',
      card_price:      '$19.990 CLP'
    %}

    {% render 'product-card',
      card_url:        '#',
      card_image_src:  'placeholder-hoodie.png' | asset_url,
      card_image_alt:  'Hoodie Dark Edition',
      card_image_id:   'product-card-3',
      card_title:      'Hoodie Dark Edition',
      card_price:      '$39.990 CLP',
      card_badge:      'Agotado',
      card_badge_type: 'danger',
      card_cta:        'Notificarme',
      card_cta_style:  'secondary'
    %}

    {% render 'product-card',
      card_url:        '#',
      card_image_src:  'placeholder-tee.png' | asset_url,
      card_image_alt:  'Tee Oversize Logo',
      card_image_id:   'product-card-4',
      card_title:      'Tee Oversize Logo',
      card_price:      '$22.990 CLP',
      card_badge:      'Nuevo',
      card_badge_type: 'accent'
    %}
  </div>

  <div class="featured-products__cta">
    <a href="#" class="btn btn-secondary">Ver Todo →</a>
  </div>
</section>

{% stylesheet %}
  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .featured-products__cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .featured-products__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Swamp Mode"
    }
  ]
}
{% endschema %}
