{% comment %}
  Swamp Mode — Footer Section
  Premium 4-column footer with branding, navigation, info, and newsletter.
  
  PLACEHOLDER MODE: Static content used until Shopify store is active.
{% endcomment %}

<footer class="footer" id="site-footer">
  <div class="footer__inner">
    {% comment %} ── Top: 4 Column Grid ── {% endcomment %}
    <div class="footer__grid">
      
      {% comment %} Column 1: Brand {% endcomment %}
      <div class="footer__col footer__col--brand">
        <a href="{{ routes.root_url | default: '#' }}" class="footer__logo">
          <span class="footer__logo-text">SWAMP<span class="footer__logo-accent">MODE</span></span>
        </a>
        <p class="footer__brand-desc">
          Streetwear sin límites. Nacidos en el pantano, vestimos la calle con actitud y ediciones limitadas.
        </p>
        <div class="footer__social">
          <a href="#" class="footer__social-link" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="#" class="footer__social-link" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.98a8.18 8.18 0 004.76 1.52V7.05a4.84 4.84 0 01-1-.36z"/>
            </svg>
          </a>
          <a href="#" class="footer__social-link" aria-label="Twitter / X">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      {% comment %} Column 2: Shop {% endcomment %}
      <div class="footer__col">
        <h4 class="footer__col-title">Shop</h4>
        <nav class="footer__links" aria-label="Navegación de tienda">
          {% comment %} PLACEHOLDER: Replace with section.settings.menu.links loop {% endcomment %}
          <a href="#" class="footer__link">Hoodies</a>
          <a href="#" class="footer__link">Tees</a>
          <a href="#" class="footer__link">Pants</a>
          <a href="#" class="footer__link">Accesorios</a>
          <a href="#" class="footer__link footer__link--accent">Sale</a>
        </nav>
      </div>

      {% comment %} Column 3: Info {% endcomment %}
      <div class="footer__col">
        <h4 class="footer__col-title">Info</h4>
        <nav class="footer__links" aria-label="Información">
          <a href="#" class="footer__link">Envíos y Entregas</a>
          <a href="#" class="footer__link">Cambios y Devoluciones</a>
          <a href="#" class="footer__link">Guía de Tallas</a>
          <a href="#" class="footer__link">FAQ</a>
          <a href="#" class="footer__link">Contacto</a>
        </nav>
      </div>

      {% comment %} Column 4: Newsletter {% endcomment %}
      <div class="footer__col footer__col--newsletter">
        <h4 class="footer__col-title">Únete al Swamp</h4>
        <p class="footer__newsletter-desc">Recibe drops exclusivos y descuentos antes que nadie.</p>
        {% comment %} PLACEHOLDER: Replace with Shopify newsletter form when store is active {% endcomment %}
        <form class="footer__newsletter-form" onsubmit="event.preventDefault();">
          <div class="footer__newsletter-input-wrap">
            <input
              type="email"
              class="footer__newsletter-input"
              placeholder="tu@email.com"
              aria-label="Email para newsletter"
              required
            >
            <button type="submit" class="footer__newsletter-btn" aria-label="Suscribirse">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    {% comment %} ── Bottom Bar ── {% endcomment %}
    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {% comment %} PLACEHOLDER: Replace with {{ shop.name }} {% endcomment %}
        Swamp Mode. Todos los derechos reservados.
      </p>
      <div class="footer__bottom-links">
        <a href="#" class="footer__bottom-link">Privacidad</a>
        <a href="#" class="footer__bottom-link">Términos</a>
      </div>
      {% comment %} Payment icons placeholder {% endcomment %}
      <div class="footer__payment">
        {% if section.settings.show_payment_icons %}
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  /* ── Footer Base ── */
  .footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-margin) var(--space-xl);
  }

  /* ── Grid ── */
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  /* ── Column ── */
  .footer__col-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-foreground);
    margin-bottom: var(--space-lg);
  }

  /* ── Brand Column ── */
  .footer__logo {
    display: inline-block;
    text-decoration: none;
    margin-bottom: var(--space-md);
  }

  .footer__logo:hover {
    opacity: 1;
  }

  .footer__logo-text {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-foreground);
  }

  .footer__logo-accent {
    color: var(--color-accent);
    margin-left: 0.15em;
  }

  .footer__brand-desc {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 30ch;
    margin-bottom: var(--space-lg);
  }

  /* ── Social ── */
  .footer__social {
    display: flex;
    gap: var(--space-sm);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    transition: var(--transition-fast);
  }

  .footer__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-muted);
  }

  /* ── Links ── */
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__link {
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-accent);
    padding-left: 4px;
  }

  .footer__link--accent {
    color: var(--color-accent);
  }

  /* ── Newsletter ── */
  .footer__newsletter-desc {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .footer__newsletter-input-wrap {
    display: flex;
    border: 1px solid var(--color-border);
    transition: var(--transition-fast);
  }

  .footer__newsletter-input-wrap:focus-within {
    border-color: var(--color-accent);
  }

  .footer__newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    color: var(--color-foreground);
    font-size: 0.875rem;
    outline: none;
  }

  .footer__newsletter-input::placeholder {
    color: var(--color-muted);
  }

  .footer__newsletter-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    background-color: var(--color-accent);
    color: var(--color-bg);
    border: none;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .footer__newsletter-btn:hover {
    background-color: var(--color-accent-hover);
  }

  /* ── Bottom Bar ── */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-xl);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .footer__copyright {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .footer__bottom-links {
    display: flex;
    gap: var(--space-lg);
  }

  .footer__bottom-link {
    color: var(--color-muted);
    font-size: 0.75rem;
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .footer__bottom-link:hover {
    color: var(--color-accent);
  }

  .footer__payment {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .footer__payment svg {
    width: 2.25rem;
    height: auto;
    opacity: 0.5;
  }

  /* ── Desktop Layout ── */
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
      gap: var(--space-3xl);
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* ── Tablet ── */
  @media (min-width: 480px) and (max-width: 767px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__col--brand,
    .footer__col--newsletter {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swamp Mode Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
