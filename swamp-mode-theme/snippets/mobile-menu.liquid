{% comment %}
  Swamp Mode — Mobile Menu Drawer
  Fullscreen slide-in navigation for mobile devices.
  Controlled by JS in header.liquid.

  PLACEHOLDER MODE: Static links used until Shopify store menus are configured.
{% endcomment %}

{%- comment -%} Overlay backdrop {%- endcomment -%}
<div class="mobile-menu__overlay" id="mobile-menu-overlay" aria-hidden="true"></div>

{%- comment -%} Drawer panel {%- endcomment -%}
<nav class="mobile-menu" id="mobile-menu" aria-label="Menú móvil" aria-hidden="true">
  <div class="mobile-menu__content">

    {%- comment -%} Main navigation links {%- endcomment -%}
    <div class="mobile-menu__links">
      <a href="{{ routes.root_url }}" class="mobile-menu__link">Inicio</a>
      <a href="{{ routes.collections_url }}" class="mobile-menu__link">Drops</a>
      <a href="{{ routes.collections_url }}/poleras" class="mobile-menu__link">Poleras</a>
      <a href="{{ routes.collections_url }}/hoodies" class="mobile-menu__link">Hoodies</a>
      <a href="/pages/nosotros" class="mobile-menu__link">Nosotros</a>
    </div>

    {%- comment -%} Secondary links {%- endcomment -%}
    <div class="mobile-menu__secondary">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="mobile-menu__secondary-link">Mi Cuenta</a>
      {% endif %}
      <a href="{{ routes.search_url }}" class="mobile-menu__secondary-link">Buscar</a>
      <a href="/pages/envios" class="mobile-menu__secondary-link">Envíos</a>
      <a href="/pages/contacto" class="mobile-menu__secondary-link">Contacto</a>
    </div>

    {%- comment -%} Social links {%- endcomment -%}
    <div class="mobile-menu__social">
      <a href="#" class="mobile-menu__social-link" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
      <a href="#" class="mobile-menu__social-link" aria-label="TikTok">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.98a8.18 8.18 0 004.76 1.52V7.05a4.84 4.84 0 01-1-.36z"/>
        </svg>
      </a>
    </div>

  </div>
</nav>

{% stylesheet %}
  /* ═══════════════════════════════════════
     Mobile Menu — Overlay
     ═══════════════════════════════════════ */

  .mobile-menu__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: calc(var(--z-sticky) + 1);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-base),
      visibility var(--transition-base);
  }

  .mobile-menu__overlay.is-active {
    opacity: 1;
    visibility: visible;
  }


  /* ═══════════════════════════════════════
     Mobile Menu — Drawer
     ═══════════════════════════════════════ */

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: min(85vw, 360px);
    height: 100dvh;
    background-color: var(--color-background);
    z-index: calc(var(--z-sticky) + 2);
    transform: translateX(-100%);
    transition: transform var(--transition-base);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-right: 1px solid var(--color-border);
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  .mobile-menu__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding: 5rem var(--space-xl) var(--space-2xl);
  }


  /* ─── Main Links ─── */

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .mobile-menu__link {
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: var(--font-heading--weight);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-foreground);
    text-decoration: none;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
    transition:
      color var(--transition-fast),
      padding-left var(--transition-fast);
    display: block;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus-visible {
    color: var(--color-accent);
    padding-left: var(--space-sm);
  }


  /* ─── Secondary Links ─── */

  .mobile-menu__secondary {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__secondary-link {
    font-family: var(--font-primary--family);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--transition-fast);
  }

  .mobile-menu__secondary-link:hover {
    color: var(--color-accent);
  }


  /* ─── Social ─── */

  .mobile-menu__social {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .mobile-menu__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }


  /* ─── Hide on desktop ─── */

  @media (min-width: 769px) {
    .mobile-menu,
    .mobile-menu__overlay {
      display: none;
    }
  }
{% endstylesheet %}
