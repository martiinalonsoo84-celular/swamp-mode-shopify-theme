{% comment %}
  Swamp Mode — Mobile Menu Drawer
  Fullscreen slide-in navigation for mobile devices.
  
  PLACEHOLDER MODE: Static links used until Shopify store is active.
{% endcomment %}

{% comment %} Overlay backdrop {% endcomment %}
<div class="mobile-menu__overlay" id="mobile-menu-overlay" aria-hidden="true"></div>

{% comment %} Drawer {% endcomment %}
<nav class="mobile-menu" id="mobile-menu" aria-label="Menú móvil" aria-hidden="true">
  <div class="mobile-menu__content">
    {% comment %} Main navigation links {% endcomment %}
    <div class="mobile-menu__links">
      {% comment %} PLACEHOLDER: Replace with section.settings.menu.links loop {% endcomment %}
      <a href="#" class="mobile-menu__link">Hoodies</a>
      <a href="#" class="mobile-menu__link">Tees</a>
      <a href="#" class="mobile-menu__link">Pants</a>
      <a href="#" class="mobile-menu__link">Accesorios</a>
      <a href="#" class="mobile-menu__link mobile-menu__link--sale">Sale</a>
    </div>

    {% comment %} Secondary links {% endcomment %}
    <div class="mobile-menu__secondary">
      <a href="#" class="mobile-menu__secondary-link">Mi Cuenta</a>
      <a href="#" class="mobile-menu__secondary-link">Envíos</a>
      <a href="#" class="mobile-menu__secondary-link">FAQ</a>
      <a href="#" class="mobile-menu__secondary-link">Contacto</a>
    </div>

    {% comment %} Social links {% endcomment %}
    <div class="mobile-menu__social">
      <a href="#" class="mobile-menu__social-link" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
      <a href="#" class="mobile-menu__social-link" aria-label="TikTok">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.98a8.18 8.18 0 004.76 1.52V7.05a4.84 4.84 0 01-1-.36z"/>
        </svg>
      </a>
      <a href="#" class="mobile-menu__social-link" aria-label="Twitter / X">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

{% stylesheet %}
  /* ── Overlay ── */
  .mobile-menu__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: var(--z-overlay);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-base);
  }

  .mobile-menu__overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* ── Drawer ── */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: min(85vw, 380px);
    height: 100vh;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: var(--z-drawer);
    transform: translateX(-100%);
    transition: var(--transition-drawer);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-right: 1px solid var(--color-border);
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  .mobile-menu__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding: calc(var(--header-height) + var(--space-2xl)) var(--space-xl) var(--space-2xl);
  }

  /* ── Main Links ── */
  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .mobile-menu__link {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-foreground);
    text-decoration: none;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
    transition: var(--transition-fast);
    display: block;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus-visible {
    color: var(--color-accent);
    padding-left: var(--space-sm);
  }

  .mobile-menu__link--sale {
    color: var(--color-accent);
  }

  /* ── Secondary Links ── */
  .mobile-menu__secondary {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__secondary-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .mobile-menu__secondary-link:hover {
    color: var(--color-accent);
  }

  /* ── Social ── */
  .mobile-menu__social {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    transition: var(--transition-fast);
  }

  .mobile-menu__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ── Hide on desktop ── */
  @media (min-width: 768px) {
    .mobile-menu,
    .mobile-menu__overlay {
      display: none;
    }
  }
{% endstylesheet %}
